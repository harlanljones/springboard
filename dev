#!/usr/bin/env bash
# dev — primary entrypoint for development on the springboard repo under Hermes.
#
# Usage:
#   ./dev              launch an interactive Hermes session (springboard profile)
#   ./dev -q "prompt"  one-shot query (args pass straight through to hermes)
#   ./dev setup        bootstrap only: profile, prune, hooks, project skills, trust
#   ./dev doctor       verify the environment without launching
#
# Idempotent: safe to run repeatedly. Never modifies the default profile —
# everything happens under the `springboard` profile or inside this repo.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE="springboard"

cd "$REPO_ROOT"

if ! command -v hermes >/dev/null 2>&1; then
  echo "error: hermes not on PATH (install: curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash)" >&2
  exit 1
fi

profile_exists() {
  hermes profile list 2>/dev/null | grep -qE "^[│┃ ]*${PROFILE}( |$|…)" || \
    [ -d "$HOME/.hermes/profiles/${PROFILE}" ]
}

# Skills disabled in the springboard profile — everything not relevant to a
# Spring Boot + React repo. Kept here so a fresh machine can rebuild the profile
# exactly. MUST stay a single line (it is expanded through $(...) below).
build_disabled_list() {
  cat <<'JSON'
["agent-reach","ai-image-generation","airtable","animate","animate-expo","animation-vocabulary","apple-design","apple-notes","apple-reminders","archify","architecture-diagram","arxiv","ascii-video","ask-sonner","baoyu-infographic","blocked-page-recovery","box","chezmoi-dotfiles","claude-code","claude-design","codex","company-brain-demo","competitor-news-monitor","computer-use","design-md","docker-nextjs","document-to-action-items","docx","dogfood","editor","email-inbox-triage","emil-design-eng","find-animation-opportunities","findmy","flyai","gif-search","google-workspace","grounded-citations","hermes-repo-devsetup","hermes-repo-profiles","himalaya","humanizer","imessage","impeccable","improve-animations","inspecting-hermes-desktop-dom","jev-tooling","llm-wiki","manim-video","maps","market-competitor-research","meeting-action-items","nextjs-docker-env","notion","obsidian","omarchy-hyprland-config","omarchy-plugins","opencode","p5js","pdf","pick-ui-library","popular-web-designs","powerpoint","product-price-monitor","profile-site","python-debugpy","ratatui-tui","repo-scaffold","review-animations","rust","scrollcraft","sdlc-review","songsee","songwriting-and-ai-music","sqlite","supabase","supabase-postgres-best-practices","teams-meeting-pipeline","typesafe-ai","vercel-env-secrets","watch","weekly-review-planning","write-swift","xlsx","xurl","youtube-content"]
JSON
}

ensure_profile() {
  if profile_exists; then
    return 0
  fi
  echo "[dev] creating '${PROFILE}' profile (cloned from default)..."
  hermes profile create "$PROFILE" --clone \
    --description "springboard repo dev: Spring Boot 4.1 / Java 25 / Maven + React 19 / Vite 8 / bun full-stack starter" >/dev/null
}

ensure_skill_prune() {
  local stored
  stored="$(hermes --profile "$PROFILE" config get skills.disabled 2>/dev/null || true)"
  # `config get` prints the stored list as YAML ('- name' lines) and prints
  # "Config key not set: <key>" when unset — never test for a leading '['.
  if ! printf '%s' "$stored" | grep -qE '^Config key not set'; then
    if printf '%s' "$stored" | grep -qE '^[[:space:]]*- '; then
      return 0
    fi
  fi
  echo "[dev] pruning irrelevant skills from '${PROFILE}' profile..."
  hermes --profile "$PROFILE" config set skills.disabled "$(build_disabled_list)" >/dev/null 2>&1 || true
}

ensure_hooks() {
  local configured
  configured="$(hermes --profile "$PROFILE" config get hooks.pre_tool_call 2>/dev/null || true)"
  if printf '%s' "$configured" | grep -q 'springboard-git-guard'; then
    return 0
  fi
  echo "[dev] registering hook scripts in '${PROFILE}' profile..."
  hermes --profile "$PROFILE" config set hooks.pre_tool_call \
    '[{"matcher":"terminal|execute_code","command":"~/.hermes/agent-hooks/springboard-git-guard.sh","timeout":10,"fail_closed":true}]' --force >/dev/null
  hermes --profile "$PROFILE" config set hooks.post_tool_call \
    '[{"matcher":"write_file|patch","command":"~/.hermes/agent-hooks/springboard-formatter.sh","timeout":15},{"matcher":"terminal","command":"~/.hermes/agent-hooks/springboard-evidence.sh","timeout":10}]' --force >/dev/null
  hermes --profile "$PROFILE" config set hooks.pre_llm_call \
    '[{"command":"~/.hermes/agent-hooks/springboard-inject-git-status.sh","timeout":5}]' --force >/dev/null
}

ensure_project_skills() {
  local missing=0
  local -a sd=(test-driven-development systematic-debugging requesting-code-review \
               simplify-code spike codebase-inspection github grill-me \
               subagent-driven-development shell-portability node-inspect-debugger \
               hermes-agent-skill-authoring)
  local -a cats=(dockerize-web-app:devops hermes-agent:autonomous-ai-agents 1password:security)
  local -a root_lv=(unlazy)
  mkdir -p .hermes/skills
  local s t pair
  for s in "${sd[@]}"; do
    [ -e ".hermes/skills/$s/SKILL.md" ] || { ln -sfn "$HOME/.hermes/skills/software-development/$s" ".hermes/skills/$s"; missing=1; }
  done
  for pair in "${cats[@]}"; do
    s="${pair%%:*}"; t="${pair##*:}"
    [ -e ".hermes/skills/$s/SKILL.md" ] || { ln -sfn "$HOME/.hermes/skills/$t/$s" ".hermes/skills/$s"; missing=1; }
  done
  for s in "${root_lv[@]}"; do
    [ -e ".hermes/skills/$s/SKILL.md" ] || { ln -sfn "$HOME/.hermes/skills/$s" ".hermes/skills/$s"; missing=1; }
  done
  # Repair links whose target moved between category dirs.
  for s in "${sd[@]}" "${root_lv[@]}" dockerize-web-app hermes-agent 1password; do
    if [ -L ".hermes/skills/$s" ] && [ ! -e ".hermes/skills/$s/SKILL.md" ]; then
      t="$(find "$HOME/.hermes/skills" -maxdepth 2 -type d -name "$s" 2>/dev/null | head -1)"
      [ -n "$t" ] && ln -sfn "$t" ".hermes/skills/$s"
    fi
  done
  [ "$missing" -eq 1 ] && echo "[dev] bootstrapped .hermes/skills project links"
  return 0
}

ensure_trust() {
  if ! hermes --profile "$PROFILE" skills trust . 2>&1 | grep -q "Already trusted"; then
    echo "[dev] trusted repo for project skills"
  fi
  return 0
}

doctor() {
  local fail=0 count broken
  if profile_exists; then
    echo "ok: profile '${PROFILE}' exists"
  else
    echo "MISSING: profile '${PROFILE}'"; fail=1
  fi

  # Prune guard: the stored value must be a YAML list of skill names.
  local stored
  stored="$(hermes --profile "$PROFILE" config get skills.disabled 2>/dev/null || true)"
  if printf '%s' "$stored" | grep -qE '^[[:space:]]*- '; then
    echo "ok: skills.disabled holds $(printf '%s' "$stored" | grep -cE '^[[:space:]]*- ') disabled skill(s)"
  else
    echo "MISSING: skills.disabled not pruned (run ./dev setup)"; fail=1
  fi

  if [ -d .hermes/skills ]; then
    broken=0
    for d in .hermes/skills/*/; do
      [ -e "${d}SKILL.md" ] || { echo "BROKEN: ${d}"; broken=1; fail=1; }
    done
    if [ "$broken" -eq 0 ]; then
      echo "ok: project skill links ($(find .hermes/skills -maxdepth 1 -mindepth 1 | wc -l | tr -d ' ') links)"
    fi
  else
    echo "MISSING: .hermes/skills"; fail=1
  fi

  count="$(hermes --profile "$PROFILE" skills trust . 2>&1 | grep -oE '[0-9]+ project skill' | grep -oE '^[0-9]+' || true)"
  echo "ok: ${count:-0} project skill(s) load in this repo"

  # Hooks: configured AND executable (a chmod miss fails silently at runtime).
  local key
  for key in "hooks.pre_tool_call:springboard-git-guard" \
             "hooks.post_tool_call:springboard-formatter" \
             "hooks.pre_llm_call:springboard-inject-git-status"; do
    if hermes --profile "$PROFILE" config get "${key%%:*}" 2>/dev/null | grep -q "${key##*:}"; then
      echo "ok: ${key##*:} hook configured"
    else
      echo "MISSING: ${key##*:} hook (profile config)"; fail=1
    fi
  done
  if hermes --profile "$PROFILE" config get hooks.post_tool_call 2>/dev/null | grep -q 'springboard-evidence'; then
    echo "ok: springboard-evidence hook configured"
  else
    echo "MISSING: springboard-evidence hook (profile config)"; fail=1
  fi
  local h
  for h in springboard-git-guard.sh springboard-evidence.sh springboard-formatter.sh springboard-inject-git-status.sh; do
    [ -x "$HOME/.hermes/agent-hooks/$h" ] || { echo "MISSING: hook script $h (or not executable)"; fail=1; }
  done
  [ "$fail" -eq 0 ] && echo "ok: all hook scripts present and executable"

  # Toolchain
  if [ -f .mise.toml ]; then
    echo "ok: .mise.toml pins $(grep -cE '^(java|node) *= ' .mise.toml) tool(s)"
  else
    echo "MISSING: .mise.toml (toolchain pin)"; fail=1
  fi
  if command -v bun >/dev/null 2>&1; then
    echo "ok: bun ($(bun --version))"
  else
    echo "MISSING: bun (https://bun.sh)"; fail=1
  fi
  if command -v mise >/dev/null 2>&1 && mise exec -- java -version >/dev/null 2>&1; then
    echo "ok: java via mise ($(mise exec -- java -version 2>&1 | head -1 | cut -d'"' -f2))"
  elif java -version >/dev/null 2>&1; then
    echo "ok: java on PATH ($(java -version 2>&1 | head -1 | cut -d'"' -f2))"
  else
    echo "MISSING: java (run 'mise install' in this repo)"; fail=1
  fi
  [ -d web/node_modules ] && echo "ok: web/node_modules present" || echo "hint: run 'cd web && bun install'"
  [ -d target ] && echo "ok: target/ present" || echo "hint: run './mvnw test' once"

  echo "note: hook allowlist is per-profile — first session start may prompt, or run: hermes --profile $PROFILE --accept-hooks"
  return "$fail"
}

case "${1:-}" in
  setup)
    ensure_profile
    ensure_skill_prune
    ensure_hooks
    ensure_project_skills
    ensure_trust
    echo "[dev] setup complete"
    ;;
  doctor)
    ensure_profile 2>/dev/null || true
    doctor || exit 1
    ;;
  *)
    ensure_profile
    ensure_skill_prune
    ensure_hooks
    ensure_project_skills
    ensure_trust
    exec hermes --profile "$PROFILE" "$@"
    ;;
esac
